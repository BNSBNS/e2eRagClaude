# ============================================================================
# AI Document Processing Platform - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control!
# ============================================================================

# ============================================================================
# APPLICATION
# ============================================================================
APP_NAME="AI Document Processing Platform"
ENVIRONMENT=development  # development, staging, production
DEBUG=true

# ============================================================================
# SECURITY - CRITICAL: MUST SET THESE
# ============================================================================

# JWT Secret Key - Generate with: openssl rand -hex 32
# NEVER use the default! Generate a new one for each environment
SECRET_KEY=your-generated-secret-key-here-use-openssl-rand-hex-32-minimum

# JWT Token Settings
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL
POSTGRES_DB=ai_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-strong-postgres-password
DATABASE_URL=postgresql+asyncpg://postgres:your-strong-postgres-password@postgres:5432/ai_platform

# Redis Connection
REDIS_URL=redis://redis:6379/0

# Neo4j Connection (for Graph RAG)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-strong-neo4j-password

# ============================================================================
# AI / ML - CRITICAL: MUST SET OPENAI_API_KEY
# ============================================================================

# OpenAI API Key - Get from https://platform.openai.com/api-keys
# Must start with 'sk-'
OPENAI_API_KEY=sk-your-actual-openai-api-key-here

# Model Selection
OPENAI_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-ada-002

# ============================================================================
# VECTOR DATABASE (ChromaDB)
# ============================================================================
CHROMA_HOST=chromadb
CHROMA_PORT=8000
CHROMA_URL=http://chromadb:8000

# ============================================================================
# CORS (Cross-Origin Resource Sharing)
# ============================================================================

# Allowed origins (comma-separated for production)
# Development (Docker):
CORS_ORIGINS=http://localhost:3000,http://frontend:3000

# Production example:
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# ============================================================================
# FILE UPLOAD
# ============================================================================
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE=52428800  # 50 MB in bytes

# ============================================================================
# MONITORING
# ============================================================================
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# Grafana Credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-strong-grafana-password

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production:
#
# 1. ✓ SECRET_KEY: Generate new with `openssl rand -hex 32`
# 2. ✓ OPENAI_API_KEY: Set your actual OpenAI API key (starts with 'sk-')
# 3. ✓ POSTGRES_PASSWORD: Use strong unique password
# 4. ✓ NEO4J_PASSWORD: Use strong unique password
# 5. ✓ GRAFANA_PASSWORD: Use strong unique password
# 6. ✓ DATABASE_URL: Update with production PostgreSQL credentials
# 7. ✓ REDIS_URL: Update with production Redis instance
# 8. ✓ NEO4J_URI: Update with production Neo4j instance
# 9. ✓ CORS_ORIGINS: Set to your actual production domain(s) only
# 10. ✓ DEBUG: Set to false
# 11. ✓ ENVIRONMENT: Set to 'production'
# 12. ✓ UPLOAD_DIR: Set to persistent volume mount
#
# Security Notes:
# - NEVER commit .env file to git (ensure .gitignore includes .env)
# - NEVER share SECRET_KEY, API keys, or passwords
# - Rotate all keys/passwords if exposed
# - Use environment-specific .env files (.env.production, .env.staging)
# - Store secrets in secure vault (AWS Secrets Manager, Azure Key Vault, etc.)
# - Minimum password length: 16 characters
# - Use different passwords for each service
